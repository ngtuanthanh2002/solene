---
/** Các lớp phủ toàn cục: giỏ hàng, tìm kiếm, đăng nhập, xem nhanh, toast, concierge */
import Icon from './Icon.astro';
import AuthForms from './AuthForms.astro';
import { POPULAR_KEYWORDS } from '../data/nav';
import { SITE } from '../config';
---
<div class="overlay" data-overlay aria-hidden="true"></div>

<!-- Giỏ hàng -->
<aside class="drawer drawer--right" id="cart" data-drawer="cart" aria-label="Giỏ hàng" aria-hidden="true" tabindex="-1">
  <div class="drawer__head">
    <h2 class="drawer__title">Giỏ hàng<sup data-cart-count-text>(0)</sup></h2>
    <button class="icon-btn" type="button" data-drawer-close aria-label="Đóng giỏ hàng"><Icon name="close" /></button>
  </div>
  <div class="ship-progress"><Icon name="truck" /><span>Miễn phí giao hàng &amp; bảo hiểm 100% giá trị · Hộp quà Solène</span></div>
  <div class="drawer__body" data-cart-items aria-live="polite"></div>
  <div class="drawer__foot" data-cart-foot hidden>
    <div class="totals" style="margin-bottom:1.1rem">
      <div class="totals__row"><span>Tạm tính</span><span data-cart-subtotal>0 ₫</span></div>
      <div class="totals__row muted"><span>Giao hàng &amp; bảo hiểm</span><span>Miễn phí</span></div>
    </div>
    <div style="display:grid;gap:.6rem">
      <a class="btn btn--block" href="/thanh-toan/"><Icon name="lock" />Thanh toán an toàn</a>
      <a class="btn btn--outline btn--block" href="/gio-hang/">Xem giỏ hàng</a>
    </div>
    <p class="tiny muted center" style="margin:.9rem 0 0">Trả góp 0% · Đổi mẫu trong 15 ngày · Bảo hành trọn đời</p>
  </div>
</aside>

<!-- Tìm kiếm -->
<div class="search-panel" data-search-panel role="dialog" aria-modal="true" aria-label="Tìm kiếm sản phẩm" aria-hidden="true">
  <div class="container search-panel__top">
    <form class="search-panel__form" action="/tim-kiem/" method="get" role="search" data-search-form>
      <Icon name="search" />
      <label class="sr-only" for="search-input">Tìm kiếm</label>
      <input id="search-input" class="search-panel__input" name="q" type="search" placeholder="Bạn đang tìm món trang sức nào?" autocomplete="off" enterkeyhint="search" data-search-input />
    </form>
    <button class="icon-btn" type="button" data-search-close aria-label="Đóng tìm kiếm"><Icon name="close" /></button>
  </div>
  <div class="container search-panel__body">
    <div>
      <h4>Tìm kiếm phổ biến</h4>
      <div class="chips" style="margin-bottom:2rem">{POPULAR_KEYWORDS.map((k) => <a class="chip" href={`/tim-kiem/?q=${encodeURIComponent(k)}`} data-search-term={k}>{k}</a>)}</div>
      <div data-recent-wrap hidden>
        <h4>Tìm kiếm gần đây</h4>
        <div class="chips" data-recent style="margin-bottom:2rem"></div>
      </div>
      <h4>Lối tắt</h4>
      <ul class="list-reset" style="display:grid;gap:.6rem;font-size:.92rem">
        <li><a class="link-inline" href="/thiet-ke-nhan/">Thiết kế nhẫn riêng</a></li>
        <li><a class="link-inline" href="/huong-dan-do-ni-tay/">Hướng dẫn đo ni tay</a></li>
        <li><a class="link-inline" href="/kien-thuc-kim-cuong/">Cẩm nang kim cương 4C</a></li>
        <li><a class="link-inline" href="/dat-lich-hen/">Đặt lịch hẹn tại showroom</a></li>
      </ul>
    </div>
    <div>
      <h4 data-search-heading>Gợi ý dành cho bạn</h4>
      <div class="search-results" data-search-results></div>
      <a class="link" href="/tim-kiem/" data-search-all hidden style="margin-top:1.6rem">Xem tất cả kết quả <Icon name="arrow-right" /></a>
    </div>
  </div>
</div>

<!-- Đăng nhập -->
<div class="modal" id="auth" data-modal="auth" aria-hidden="true">
  <div class="modal__backdrop" data-modal-close></div>
  <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="m-title" style="--w:480px" tabindex="-1">
    <button class="icon-btn modal__close" type="button" data-modal-close aria-label="Đóng"><Icon name="close" /></button>
    <AuthForms prefix="m" />
  </div>
</div>

<!-- Xem nhanh -->
<div class="modal" id="quickview" data-modal="quickview" aria-hidden="true">
  <div class="modal__backdrop" data-modal-close></div>
  <div class="modal__dialog" role="dialog" aria-modal="true" aria-label="Xem nhanh sản phẩm" style="--w:1000px" tabindex="-1">
    <button class="icon-btn modal__close" type="button" data-modal-close aria-label="Đóng"><Icon name="close" /></button>
    <div data-quickview-body></div>
  </div>
</div>

<div class="toasts" data-toasts role="status" aria-live="polite"></div>

<div class="fab-stack">
  <button class="fab fab--top" type="button" data-to-top aria-label="Lên đầu trang"><Icon name="arrow-up" /></button>
  <div style="position:relative">
    <div class="concierge" id="concierge" data-concierge>
      <div class="concierge__head"><p class="serif">Concierge Solène</p><p>Chuyên viên đang trực tuyến</p></div>
      <ul>
        <li><a href={SITE.phoneHref}><Icon name="phone" /><span>Gọi hotline<small>{SITE.phone} · miễn phí</small></span></a></li>
        <li><a href={SITE.zalo} target="_blank" rel="noopener"><Icon name="chat" /><span>Nhắn tin Zalo<small>Phản hồi trong 5 phút</small></span></a></li>
        <li><a href="/dat-lich-hen/"><Icon name="calendar" /><span>Đặt lịch hẹn riêng<small>Showroom Sài Gòn &amp; Hà Nội</small></span></a></li>
        <li><a href={`mailto:${SITE.email}`}><Icon name="mail" /><span>Gửi email<small>{SITE.email}</small></span></a></li>
      </ul>
    </div>
    <button class="fab fab--chat" type="button" data-concierge-toggle aria-expanded="false" aria-controls="concierge" aria-label="Liên hệ tư vấn"><Icon name="chat" /></button>
  </div>
</div>
