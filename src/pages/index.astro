---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import ProductCard from '../components/ProductCard.astro';
import { SITE } from '../config';
import { bestsellers, newest, byCategory } from '../data/products';
import { imageUrl, imageSrcset } from '../lib/catalog';
import { ringSVG } from '../lib/ring-svg';

const site = Astro.site!.href;
const best = bestsellers(4);
const fresh = newest(4);
const wedding = byCategory('nhan-cuoi').sort((a, b) => b.sold - a.sold).slice(0, 4);

const categories = [
  { label: 'Nhẫn cầu hôn', href: '/nhan-cau-hon/', img: 'ring-cushion-halo' },
  { label: 'Nhẫn cưới', href: '/nhan-cuoi/', img: 'band-interlock' },
  { label: 'Dây chuyền', href: '/trang-suc/?loai=day-chuyen', img: 'neck-cushion-halo' },
  { label: 'Bông tai', href: '/trang-suc/?loai=bong-tai', img: 'ear-torsade-hoops' },
  { label: 'Kim cương', href: '/kim-cuong/', img: 'dia-single' },
  { label: 'Cao cấp', href: '/trang-suc-cao-cap/', img: 'hj-emerald-set' },
];

const builderDemo = [
  { style: 'halo', shape: 'oval', metal: 'vang-hong-18k', carat: 1.2, label: 'Halo · Oval · Vàng hồng 18K' },
  { style: 'solitaire', shape: 'round', metal: 'vang-vang-18k', carat: 1, label: 'Solitaire · Round · Vàng vàng 18K' },
  { style: 'three-stone', shape: 'emerald', metal: 'bach-kim', carat: 1, label: 'Three Stone · Emerald · Bạch kim' },
  { style: 'royal', shape: 'pear', metal: 'vang-trang-18k', carat: 1.1, label: 'Royal · Pear · Vàng trắng 18K' },
] as const;

const services = [
  { t: 'Bảo hành trọn đời', d: 'Làm sạch, đánh bóng và kiểm tra chấu miễn phí tại mọi showroom.', href: '/chinh-sach/bao-hanh/' },
  { t: 'Khắc chữ miễn phí', d: 'Lưu giữ tên, ngày kỷ niệm hay lời hứa ở mặt trong chiếc nhẫn.', href: '/nhan-cuoi/' },
  { t: 'Kim cương kiểm định GIA', d: 'Mỗi viên chủ đều kèm giấy GIA và mã laser để đối chiếu.', href: '/kien-thuc-kim-cuong/' },
  { t: 'Giao hàng bảo hiểm', d: 'Miễn phí toàn quốc, bảo hiểm 100% giá trị trong hộp quà Solène.', href: '/chinh-sach/van-chuyen/' },
];

const orgLd = {
  '@context': 'https://schema.org', '@type': 'JewelryStore', '@id': `${site}#store`, name: SITE.legalName, url: site,
  logo: new URL('/apple-touch-icon.png', site).href, image: new URL('/og-image.jpg', site).href, description: SITE.description,
  telephone: SITE.phone, email: SITE.email, priceRange: '₫₫₫', foundingDate: String(SITE.founded),
  address: { '@type': 'PostalAddress', streetAddress: SITE.boutiques[0].street, addressLocality: SITE.boutiques[0].locality, addressCountry: 'VN' },
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '09:00', closes: '21:00' }],
  sameAs: Object.values(SITE.social),
};
const webLd = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.legalName, url: site, inLanguage: 'vi-VN',
  potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${site}tim-kiem/?q={search_term_string}` }, 'query-input': 'required name=search_term_string' },
};
---
<Base description={SITE.description} jsonld={[orgLd, webLd]} transparentHeader bodyClass="page-home">
  <link slot="head" rel="preload" as="image" href="/images/hero/hero-1920.webp" imagesrcset="/images/hero/hero-960.webp 960w, /images/hero/hero-1280.webp 1280w, /images/hero/hero-1920.webp 1920w" imagesizes="100vw" media="(min-width: 761px)" fetchpriority="high" />
  <link slot="head" rel="preload" href="/fonts/zalando-sans-expanded-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link slot="head" rel="preload" as="image" href="/images/hero/hero-sq-900.webp" imagesrcset="/images/hero/hero-sq-600.webp 600w, /images/hero/hero-sq-900.webp 900w" imagesizes="100vw" media="(max-width: 760px)" fetchpriority="high" />

  <!-- ═════════ HERO ═════════ -->
  <section class="hero" aria-labelledby="hero-title">
    <picture class="hero__media">
      <source media="(max-width: 760px)" srcset="/images/hero/hero-sq-600.webp 600w, /images/hero/hero-sq-900.webp 900w" sizes="100vw" />
      <img src="/images/hero/hero-1920.webp" srcset="/images/hero/hero-960.webp 960w, /images/hero/hero-1280.webp 1280w, /images/hero/hero-1920.webp 1920w" sizes="100vw" width="1920" height="789" alt="Nhẫn cầu hôn Silk Veil vàng 18K đính kim cương trên nền lụa champagne" fetchpriority="high" decoding="async" />
    </picture>
    <div class="hero__content container">
      <div class="hero__text">
        <p class="hero__label hero-in" style="--i:0">Bộ sưu tập mới · 2026</p>
        <h1 class="hero__title" id="hero-title">
          <span class="hero__name">Silk Veil</span>
          <span class="hero__tagline hero-in" style="--i:2">Lời hứa trọn một đời</span>
        </h1>
        <div class="hero__ctas hero-in" style="--i:3">
          <a class="btn" href="/bo-suu-tap/silk-veil/">Khám phá bộ sưu tập</a>
          <a class="link" href="/thiet-ke-nhan/">Thiết kế nhẫn riêng</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════════ DANH MỤC ═════════ -->
  <section class="section" id="danh-muc" aria-labelledby="cat-title">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <h2 id="cat-title">Khám phá Solène</h2>
      </div>
      <ul class="cats" role="list" data-stagger="0.06">
        {categories.map((c) => (
          <li data-reveal>
            <a class="cat" href={c.href}>
              <span class="cat__media"><Img k={c.img} alt={c.label} sizes="(min-width: 1100px) 15vw, (min-width: 640px) 30vw, 44vw" /></span>
              <span class="cat__name">{c.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═════════ SẢN PHẨM NỔI BẬT ═════════ -->
  <section class="section home-best" aria-labelledby="best-title">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <h2 id="best-title">Thiết kế được yêu thích</h2>
        <div class="tabs home-tabs" role="tablist" aria-label="Lọc sản phẩm nổi bật" data-tabs>
          <button class="tab" type="button" role="tab" aria-selected="true" aria-controls="tp-best" id="tb-best">Bán chạy</button>
          <button class="tab" type="button" role="tab" aria-selected="false" aria-controls="tp-new" id="tb-new" tabindex="-1">Mới ra mắt</button>
          <button class="tab" type="button" role="tab" aria-selected="false" aria-controls="tp-wed" id="tb-wed" tabindex="-1">Nhẫn cưới</button>
        </div>
      </div>
      <div class="tab-panel" id="tp-best" role="tabpanel" aria-labelledby="tb-best">
        <div class="product-grid product-grid--4">{best.map((p, i) => <ProductCard product={p} index={i} />)}</div>
      </div>
      <div class="tab-panel" id="tp-new" role="tabpanel" aria-labelledby="tb-new" hidden>
        <div class="product-grid product-grid--4">{fresh.map((p, i) => <ProductCard product={p} index={i} />)}</div>
      </div>
      <div class="tab-panel" id="tp-wed" role="tabpanel" aria-labelledby="tb-wed" hidden>
        <div class="product-grid product-grid--4">{wedding.map((p, i) => <ProductCard product={p} index={i} />)}</div>
      </div>
      <div class="center" style="margin-top:3.5rem"><a class="btn btn--outline" href="/cua-hang/">Xem tất cả</a></div>
    </div>
  </section>

  <!-- ═════════ SIGNATURE ═════════ -->
  <section class="split" aria-labelledby="silk-title">
    <div class="split__media" data-reveal="fade">
      <img src={imageUrl('ed-satin-hand', 1200)} srcset={imageSrcset('ed-satin-hand')} sizes="(min-width: 900px) 50vw, 100vw" width="1200" height="1500" alt="Bàn tay đeo nhẫn vàng trên nền lụa champagne" loading="lazy" decoding="async" />
    </div>
    <div class="split__text">
      <div data-reveal>
        <p class="eyebrow">Signature Collection</p>
        <h2 id="silk-title">Silk Veil</h2>
        <p>Lấy cảm hứng từ tà voan cô dâu khẽ bay trong nắng sớm: đường cong mềm như nếp lụa, chấu nhẫn mảnh như cánh hoa, để ánh sáng chảy liền mạch tới viên chủ.</p>
        <a class="link" href="/bo-suu-tap/silk-veil/">Khám phá bộ sưu tập</a>
      </div>
    </div>
  </section>

  <!-- ═════════ HAI CÂU CHUYỆN ═════════ -->
  <section class="section" aria-label="Nhẫn cưới và trang sức">
    <div class="container duo">
      <a class="duo__item" href="/nhan-cuoi/" data-reveal>
        <span class="duo__media"><Img k="ed-hands-white" alt="Đôi tay cô dâu chú rể đeo nhẫn cưới" sizes="(min-width: 900px) 45vw, 100vw" /></span>
        <span class="eyebrow">Nhẫn cưới</span>
        <h3>Nắm tay nhau, đi hết cuộc đời</h3>
        <span class="link">Khám phá</span>
      </a>
      <a class="duo__item" href="/trang-suc/" data-reveal style="--d:.12s">
        <span class="duo__media"><Img k="ed-necklace-light" alt="Dây chuyền vàng dưới ánh nắng" sizes="(min-width: 900px) 45vw, 100vw" /></span>
        <span class="eyebrow">Trang sức</span>
        <h3>Ánh sáng trên làn da</h3>
        <span class="link">Khám phá</span>
      </a>
    </div>
  </section>

  <!-- ═════════ THIẾT KẾ NHẪN ═════════ -->
  <section class="section section--cream builder" aria-labelledby="bt-title">
    <div class="container builder__grid">
      <div class="bt-stage" data-reveal="fade">
        <div class="bt-ring" data-bt-ring>
          {builderDemo.map((d, i) => (
            <div class:list={['bt-ring__item', { 'is-active': i === 0 }]} data-label={d.label}>
              <Fragment set:html={ringSVG({ style: d.style, shape: d.shape, metal: d.metal, carat: d.carat, uid: `bt${i}`, title: d.label })} />
            </div>
          ))}
        </div>
        <p class="bt-caption" data-bt-caption>{builderDemo[0].label}</p>
      </div>
      <div class="builder__text" data-reveal>
        <p class="eyebrow">Thiết kế riêng</p>
        <h2 id="bt-title">Chiếc nhẫn của riêng bạn</h2>
        <p>Chọn kiểu dáng, viên chủ, chất liệu và lời khắc. Xem trước trực tiếp, nhận báo giá ngay và đặt chế tác trong vài phút.</p>
        <a class="btn" href="/thiet-ke-nhan/">Bắt đầu thiết kế</a>
      </div>
    </div>
  </section>

  <!-- ═════════ ĐẶT LỊCH HẸN ═════════ -->
  <section class="split split--reverse" aria-labelledby="appt-title">
    <div class="split__media" data-reveal="fade">
      <img src={imageUrl('ed-boutique', 1200)} srcset={imageSrcset('ed-boutique')} sizes="(min-width: 900px) 50vw, 100vw" width="1200" height="1500" alt="Không gian trưng bày tại Maison Solène" loading="lazy" decoding="async" />
    </div>
    <div class="split__text">
      <div data-reveal>
        <p class="eyebrow">Maison Solène</p>
        <h2 id="appt-title">Một buổi hẹn riêng</h2>
        <p>Xem kim cương dưới kính lúp và thử nhẫn trong không gian riêng tại Sài Gòn và Hà Nội — hoàn toàn miễn phí.</p>
        <a class="btn btn--outline" href="/dat-lich-hen/">Đặt lịch hẹn</a>
      </div>
    </div>
  </section>

  <!-- ═════════ DỊCH VỤ ═════════ -->
  <section class="section services" aria-label="Dịch vụ của Solène">
    <div class="container services__grid" data-stagger="0.06">
      {services.map((s) => (
        <div class="services__item" data-reveal>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
          <a class="link" href={s.href}>Tìm hiểu thêm</a>
        </div>
      ))}
    </div>
  </section>
</Base>

<script>
  import { initHome } from '../scripts/pages/home';
  initHome();
</script>

<style is:global>
  /* ═════════ HERO ═════════ */
  .page-home .hero { position: relative; margin-top: calc(-1 * var(--header-h)); min-height: clamp(560px, 50vw, 820px); display: grid; align-items: center; overflow: hidden; background: #f1e9df; isolation: isolate; }
  .hero__media { position: absolute; inset: 0; z-index: -1; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: 70% 50%; }
  .hero__content { padding-top: calc(var(--header-h) + 2rem); padding-bottom: 4rem; }
  .hero__text { max-width: 680px; }
  .hero__label { font-family: var(--ff-hero); font-size: 0.66rem; font-weight: 400; letter-spacing: 0.22em; text-transform: uppercase; color: var(--c-muted); margin: 0 0 clamp(1.25rem, 2vw, 1.75rem); }
  .hero__title { margin: 0 0 clamp(2rem, 3.2vw, 2.75rem); font-size: inherit; line-height: 1; letter-spacing: 0; text-wrap: initial; }
  /* Tên bộ sưu tập: chữ trình diễn bè ngang (Zalando Sans Expanded), in hoa, nét mảnh — thu khoảng chữ khi xuất hiện */
  .hero__name {
    display: block; margin-right: -0.06em;
    font-family: var(--ff-hero); font-size: clamp(2.6rem, 0.6rem + 6vw, 6.6rem); font-weight: 200; line-height: 0.95; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap;
    opacity: 0; animation: heroName 1.8s var(--ease-out) 0.25s forwards;
  }
  @keyframes heroName { from { opacity: 0; letter-spacing: 0.16em; } to { opacity: 1; letter-spacing: 0.06em; } }
  .hero__tagline { display: block; margin-top: clamp(1.1rem, 1.6vw, 1.5rem); font-family: var(--ff-hero); font-size: clamp(1rem, 0.88rem + 0.45vw, 1.3rem); font-weight: 300; line-height: 1.4; letter-spacing: 0.01em; color: var(--c-ink-2); }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }
  .hero-in { opacity: 0; transform: translateY(10px); animation: fadeUp 1.1s var(--ease-out) forwards; animation-delay: calc(0.3s + var(--i) * 0.15s); }
  @media (min-width: 761px) and (max-width: 1099px) {
    .page-home .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.3) 55%, rgba(255, 255, 255, 0) 80%); }
  }
  @media (max-width: 760px) {
    .page-home .hero { display: block; min-height: 0; margin-top: 0; background: #fff; }
    .hero__media { position: relative; inset: auto; aspect-ratio: 1; }
    .hero__media img { object-position: 50% 50%; }
    .hero__content { padding: 2.25rem var(--gutter) 1rem; width: 100%; text-align: center; }
    .hero__text { margin-inline: auto; }
    .hero__title { margin-bottom: 1.9rem; }
    .hero__name { font-size: clamp(2.3rem, 11.5vw, 3.6rem); }
    .hero__label { margin-bottom: 1rem; }
    .hero__ctas { justify-content: center; }
    .hero__ctas .btn { flex: 1 1 100%; }
  }

  /* ═════════ DANH MỤC ═════════ */
  .cats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.25rem 0.75rem; list-style: none; }
  @media (min-width: 640px) { .cats { grid-template-columns: repeat(3, 1fr); gap: 2.5rem 1.25rem; } }
  @media (min-width: 1100px) { .cats { grid-template-columns: repeat(6, 1fr); } }
  .cat { display: grid; justify-items: center; text-align: center; gap: 1rem; }
  .cat__media { position: relative; display: block; width: 100%; aspect-ratio: 4 / 5; overflow: hidden; background: var(--c-bg-2); }
  .cat__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .cat:hover .cat__media img { transform: scale(1.03); }
  .cat__name { font-size: var(--fs-xxs); font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; }

  /* ═════════ SẢN PHẨM ═════════ */
  .home-best { padding-top: 0; }
  .home-best .section-head { gap: 1.25rem; }
  .home-tabs { border-bottom: 0; gap: 2.25rem; justify-content: center; }
  .tab-panel { animation: fadeUp 0.6s var(--ease-out); }

  /* ═════════ SPLIT (ảnh 50% / chữ 50%) ═════════ */
  .split { display: grid; background: var(--c-bg); }
  .split__media { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: var(--c-bg-2); }
  .split__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .split__text { display: grid; place-items: center; padding: clamp(3.5rem, 8vw, 6rem) var(--gutter); text-align: center; }
  .split__text > div { max-width: 420px; }
  .split__text h2 { margin-bottom: 1.1rem; }
  .split__text p:not(.eyebrow) { color: var(--c-ink-2); margin-bottom: 2rem; }
  .split--reverse .split__text { background: var(--c-bg-2); }
  @media (min-width: 900px) {
    .split { grid-template-columns: 1fr 1fr; }
    .split__media { aspect-ratio: auto; min-height: clamp(520px, 46vw, 760px); }
    .split--reverse .split__media { order: 2; }
  }

  /* ═════════ DUO ═════════ */
  .duo { display: grid; gap: 3.5rem 1.5rem; }
  @media (min-width: 760px) { .duo { grid-template-columns: 1fr 1fr; } }
  .duo__item { display: grid; justify-items: center; text-align: center; }
  .duo__media { position: relative; display: block; width: 100%; aspect-ratio: 4 / 5; overflow: hidden; background: var(--c-bg-2); margin-bottom: 1.75rem; }
  .duo__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease-out); }
  .duo__item:hover .duo__media img { transform: scale(1.03); }
  .duo__item .eyebrow { margin-bottom: 0.6rem; }
  .duo__item h3 { font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.6rem); font-weight: 300; margin: 0 0 1.25rem; }

  /* ═════════ THIẾT KẾ NHẪN ═════════ */
  .builder__grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .builder__grid { grid-template-columns: 1fr 1fr; gap: 4rem; } }
  .builder__text { text-align: center; max-width: 420px; margin-inline: auto; }
  .builder__text h2 { margin-bottom: 1.1rem; }
  .builder__text p:not(.eyebrow) { color: var(--c-ink-2); margin-bottom: 2rem; }
  .bt-stage { position: relative; display: grid; place-items: center; }
  .bt-ring { position: relative; width: min(400px, 82%); aspect-ratio: 200 / 180; }
  .bt-ring__item { position: absolute; inset: 0; opacity: 0; transition: opacity 1.1s var(--ease); }
  .bt-ring__item.is-active { opacity: 1; }
  .bt-ring__item svg { width: 100%; height: 100%; filter: drop-shadow(0 24px 30px rgba(0, 0, 0, 0.12)); }
  .bt-caption { margin: 1.25rem 0 0; font-size: var(--fs-xxs); font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-muted); min-height: 1.6em; transition: opacity 0.4s; }

  /* ═════════ DỊCH VỤ ═════════ */
  .services__grid { display: grid; gap: 2.75rem 2rem; }
  @media (min-width: 640px) { .services__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .services__grid { grid-template-columns: repeat(4, 1fr); gap: 3rem; } }
  .services__item { text-align: center; padding-inline: 0.5rem; }
  .services__item h3 { font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 0.75rem; }
  .services__item p { color: var(--c-muted); font-size: 0.875rem; max-width: 30ch; margin: 0 auto 1.25rem; }
</style>
