---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { ringSVG } from '../lib/ring-svg';
---
<Base title="Không tìm thấy trang" description="Trang bạn tìm không tồn tại." noindex>
  <section class="container nf">
    <div class="nf__ring" set:html={ringSVG({ style: 'solitaire', shape: 'heart', metal: 'vang-hong-18k', carat: 1.2, uid: 'nf', title: 'Nhẫn trái tim' })} />
    <p class="eyebrow">Lỗi 404</p>
    <h1>Viên kim cương này <em>đã lạc mất</em></h1>
    <p class="lead">Trang bạn tìm có thể đã được đổi tên hoặc không còn tồn tại. Hãy để chúng tôi đưa bạn trở lại.</p>
    <form class="sp-form" action="/tim-kiem/" method="get" role="search">
      <Icon name="search" /><label for="nf-q" class="sr-only">Tìm kiếm</label>
      <input id="nf-q" name="q" type="search" placeholder="Tìm nhẫn, kim cương, bộ sưu tập…" />
      <button class="btn btn--sm" type="submit">Tìm</button>
    </form>
    <div class="nf__links">
      <a class="btn" href="/">Về trang chủ</a>
      <a class="btn btn--outline" href="/nhan-cau-hon/">Nhẫn cầu hôn</a>
      <a class="btn btn--outline" href="/nhan-cuoi/">Nhẫn cưới</a>
    </div>
  </section>
</Base>
<style is:global>
  .nf { text-align: center; padding-block: clamp(2rem, 6vw, 5rem) var(--section); max-width: 760px; }
  .nf__ring { width: min(280px, 70vw); margin: 0 auto 1rem; }
  .nf__ring svg { width: 100%; height: auto; animation: float 5s ease-in-out infinite; }
  @keyframes float { 50% { transform: translateY(-10px); } }
  .nf .sp-form { margin: 2rem auto 1.6rem; display: flex; align-items: center; gap: 0.8rem; max-width: 560px; padding: 0.4rem 0.4rem 0.4rem 1.2rem; border: 1px solid var(--c-line-2); background: #fff; }
  .nf .sp-form svg { width: 20px; height: 20px; color: var(--c-gold-dark); }
  .nf .sp-form input { flex: 1; min-width: 0; border: 0; background: transparent; font-size: 1rem; padding: 0.7rem 0; }
  .nf .sp-form input:focus { outline: none; }
  .nf__links { display: flex; gap: 0.6rem; justify-content: center; flex-wrap: wrap; }
</style>
