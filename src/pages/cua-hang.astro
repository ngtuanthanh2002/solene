---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Listing from '../components/Listing.astro';
import SeoBlock from '../components/SeoBlock.astro';
import { SHOP_ALL as cat } from '../data/categories';
import { PRODUCTS } from '../data/products';
import { breadcrumbLd, itemListLd } from '../lib/seo';

const products = [...PRODUCTS].sort((a, b) => b.sold - a.sold);
const crumbs = [{ label: 'Trang chủ', href: '/' }, { label: 'Cửa hàng' }];
const site = Astro.site!;
---
<Base title={cat.title} description={cat.description} image={`/images/og/${cat.banner}.jpg`} jsonld={[breadcrumbLd(crumbs, site), itemListLd(products, site, cat.h1)]}>
  <PageHero banner={cat.banner} eyebrow={cat.eyebrow} title={cat.h1} intro={cat.intro} />
  <Listing products={products} filters={cat.filters} quick="type" crumbs={crumbs} emptyBuilder />
  <SeoBlock heading={cat.seo.heading} paragraphs={cat.seo.paragraphs} />
</Base>
