---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config';
---
<Base title="Đặt hàng thành công" description="Cảm ơn quý khách đã tin chọn Solène." noindex>
  <section class="container success" data-success>
    <canvas class="success__sparkle" data-sparkle aria-hidden="true"></canvas>
    <div class="success__card" data-success-ok hidden>
      <div class="success__icon"><Icon name="check" /></div>
      <p class="eyebrow">Đơn hàng đã được ghi nhận</p>
      <h1>Cảm ơn <em data-s-name>quý khách</em></h1>
      <p class="lead">Mã đơn hàng <b class="success__code" data-s-code></b>. Chuyên viên Solène sẽ gọi xác nhận trong vòng 30 phút (8:00 – 21:00).</p>
      <ol class="checkout-steps success__steps" role="list"><li class="is-done">Giỏ hàng</li><li class="is-done">Thông tin</li><li class="is-active">Hoàn tất</li></ol>

      <div class="bank-box" data-s-bank hidden>
        <h2><Icon name="bank" />Thông tin chuyển khoản</h2>
        <dl>
          <div><dt>Ngân hàng</dt><dd>{SITE.bank.name}</dd></div>
          <div><dt>Số tài khoản</dt><dd><b>{SITE.bank.account}</b> <button type="button" class="link-inline tiny" data-copy={SITE.bank.account.replace(/\s/g, '')}>Sao chép</button></dd></div>
          <div><dt>Chủ tài khoản</dt><dd>{SITE.bank.holder}</dd></div>
          <div><dt>Số tiền</dt><dd><b data-s-amount></b></dd></div>
          <div><dt>Nội dung</dt><dd><b data-s-code2></b> <button type="button" class="link-inline tiny" data-copy-code>Sao chép</button></dd></div>
        </dl>
        <p class="tiny muted">Đơn hàng được giữ trong 24 giờ. Tài khoản trên là thông tin minh họa của website demo.</p>
      </div>

      <div class="success__grid">
        <div class="success__block">
          <h2>Sản phẩm</h2>
          <ul class="co-items" role="list" data-s-items></ul>
          <div class="totals" data-s-totals></div>
        </div>
        <div class="success__block">
          <h2>Giao hàng</h2>
          <p data-s-ship></p>
          <h2>Thanh toán</h2>
          <p data-s-pay></p>
          <h2>Tiếp theo</h2>
          <ol class="next-steps" role="list">
            <li><Icon name="phone" />Chuyên viên gọi xác nhận đơn &amp; lời khắc</li>
            <li><Icon name="gem" />Gửi ảnh, video viên kim cương và giấy GIA</li>
            <li><Icon name="pen" />Chế tác, khắc chữ &amp; kiểm định chất lượng</li>
            <li><Icon name="gift" />Đóng hộp quà và giao hàng có bảo hiểm</li>
          </ol>
        </div>
      </div>
      <div class="success__actions">
        <a class="btn" href="/tai-khoan/#don-hang">Theo dõi đơn hàng</a>
        <a class="btn btn--outline" href="/cua-hang/">Tiếp tục mua sắm</a>
      </div>
    </div>

    <div class="empty-state" data-success-missing hidden>
      <Icon name="package" />
      <h1 style="font-size:var(--fs-2)">Không tìm thấy đơn hàng</h1>
      <p class="muted">Đơn hàng có thể được đặt trên thiết bị khác. Vui lòng kiểm tra email hoặc liên hệ hotline {SITE.phone}.</p>
      <a class="btn" href="/tai-khoan/#don-hang">Đơn hàng của tôi</a>
    </div>
  </section>
</Base>

<script>
  import { initSuccess } from '../scripts/pages/success';
  initSuccess();
</script>

<style is:global>
  .success { position: relative; padding-block: clamp(2.5rem, 6vw, 5rem) var(--section); }
  .success__sparkle { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 120; }
  .success__card { max-width: 900px; margin: 0 auto; text-align: center; }
  .success__code { font-family: var(--ff-serif); font-weight: 400; letter-spacing: 0.06em; color: var(--c-gold-dark); }
  .success__steps { justify-content: center; margin: 1.6rem 0 2.4rem; }
  .bank-box { text-align: left; max-width: 560px; margin: 0 auto 2.4rem; padding: 1.6rem; border: 1px solid var(--c-gold); background: var(--g-satin); }
  .bank-box h2 { display: flex; align-items: center; gap: 0.6rem; font-size: 1.35rem; }
  .bank-box h2 svg { width: 22px; height: 22px; color: var(--c-gold-dark); }
  .bank-box dl { display: grid; gap: 0.6rem; margin: 0 0 1rem; font-size: var(--fs-sm); }
  .bank-box dl div { display: grid; grid-template-columns: 120px 1fr; gap: 1rem; }
  .bank-box dt { color: var(--c-muted); }
  .bank-box dd { margin: 0; }
  .success__grid { display: grid; gap: 1.4rem; text-align: left; }
  @media (min-width: 860px) { .success__grid { grid-template-columns: 1.1fr 0.9fr; } }
  .success__block { padding: 1.6rem; background: #fff; border: 1px solid var(--c-line); }
  .success__block h2 { font-size: 1.2rem; margin: 0 0 0.7rem; }
  .success__block p { font-size: var(--fs-sm); color: var(--c-ink-2); margin-bottom: 1.4rem; }
  .next-steps { list-style: none; display: grid; gap: 0.7rem; font-size: var(--fs-sm); }
  .next-steps li { display: flex; gap: 0.7rem; align-items: center; }
  .next-steps svg { width: 18px; height: 18px; color: var(--c-gold-dark); flex: none; }
  .success__actions { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; margin-top: 2.4rem; }
</style>
