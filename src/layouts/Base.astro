---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/components.css';
import Header from '../components/Header.astro';
import MobileNav from '../components/MobileNav.astro';
import Footer from '../components/Footer.astro';
import Overlays from '../components/Overlays.astro';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'product' | 'article';
  noindex?: boolean;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  transparentHeader?: boolean;
  preloader?: boolean;
  bodyClass?: string;
}

const {
  title,
  description = SITE.description,
  image = '/og-image.jpg',
  imageAlt = 'Solène Fine Jewelry — nhẫn kim cương trên nền lụa champagne',
  ogType = 'website',
  noindex = false,
  jsonld,
  transparentHeader = false,
  preloader = false,
  bodyClass,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.legalName}` : `${SITE.legalName} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const ld = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];
---
<!doctype html>
<html lang="vi" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.legalName} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-vietnamese-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />

    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
      try { if (sessionStorage.getItem('solene:intro')) document.documentElement.classList.add('no-preload'); } catch (e) {}
    </script>
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj).replace(/</g, '\\u003c')} />)}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Bỏ qua đến nội dung chính</a>
    {preloader && (
      <div class="preloader" aria-hidden="true" data-preloader>
        <div class="preloader__inner">
          <svg viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M17 12h26l9 12-22 26L8 24l9-12Zm-9 12h44M24 12l-4 12 10 26 10-26-4-12" /></svg>
          <span class="logo__word">SOLÈNE</span>
        </div>
      </div>
    )}
    <Header transparent={transparentHeader} />
    <MobileNav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Overlays />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style is:global>
  .no-preload .preloader { display: none; }
  main:focus { outline: none; }
</style>
